      "id": "ad320ea6-f4b0-49ed-ae26-1941a292995f",
      "name": "Normalize Lead"
    },
    {
      "parameters": {
        "jsCode": "const allowedSources = new Set([\n  'website',\n  'form',\n  'api',\n  'facebook_ads',\n  'extension',\n  'playwright',\n  'manual',\n])\n\nreturn $input.all().map((item) => {\n  const lead = item.json;\n  const errors = [];\n\n  function addError(field, code, message) {\n    errors.push({\n      field,\n      code,\n      message,\n    });\n  }\n\n  if (!lead.full_name) {\n    addError(\n      'full_name',\n      'required',\n      'Full name is required.',\n    );\n  } else if (lead.full_name.length < 2 || lead.full_name.length > 100) {\n    addError(\n      'full_name',\n      'invalid_length',\n      'Full name must contain between 2 and 100 characters.',\n    );\n  }\n\n  // Validate the email without pretending to implement the entire email RFC.\n  if (!lead.email) {\n    addError(\n      'email',\n      'required',\n      'Email is required.',\n    );\n  } else if (lead.email.length > 254) {\n    addError(\n      'email',\n      'invalid_length',\n      'Email must not exceed 254 characters.',\n    );\n  } else if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) {\n    addError(\n      'email',\n      'invalid_format',\n      'Email must have a valid format.',\n    );\n  }\n\n  // LeadFlow is initially designed for B2B leads.\n  if (!lead.company) {\n    addError(\n      'company',\n      'required',\n      'Company is required.',\n    );\n  } else if (lead.company.length > 150) {\n    addError(\n      'company',\n      'invalid_length',\n      'Company must not exceed 150 characters.',\n    );\n  }\n\n  if (lead.role.length > 150) {\n    addError(\n      'role',\n      'invalid_length',\n      'Role must not exceed 150 characters.',\n    );\n  }\n\n  // A website is optional, but it must be a valid HTTP(S) URL when provided.\n  if (lead.website) {\n  const usesHttpProtocol = /^https?:\\/\\//i.test(lead.website);\n\n  const hasValidHttpUrlShape =\n    /^https?:\\/\\/[^/\\s?#]+(?:[/?#][^\\s]*)?$/i.test(lead.website);\n\n  if (lead.website.length > 2048) {\n    addError(\n      'website',\n      'invalid_length',\n      'Website must not exceed 2048 characters.',\n    );\n  } else if (!usesHttpProtocol) {\n    addError(\n      'website',\n      'invalid_protocol',\n      'Website must use HTTP or HTTPS.',\n    );\n  } else if (!hasValidHttpUrlShape) {\n      addError(\n        'website',\n        'invalid_format',\n        'Website must be a valid URL.',\n      );\n    }\n  }\n\n  if (!lead.source) {\n    addError(\n      'source',\n      'required',\n      'Lead source is required.',\n    );\n  } else if (!allowedSources.has(lead.source)) {\n    addError(\n      'source',\n      'unsupported_value',\n      `Source must be one of: ${[...allowedSources].join(', ')}.`,\n    );\n  }\n\n  if (lead.notes.length > 2000) {\n    addError(\n      'notes',\n      'invalid_length',\n      'Notes must not exceed 2000 characters.',\n    );\n  }\n\n  const isValid = errors.length === 0;\n\n  return {\n    json: {\n      ...lead,\n      status: isValid ? 'validated' : 'rejected',\n      validation: {\n        is_valid: isValid,\n        errors,\n      },\n    },\n  };\n})"
      },
